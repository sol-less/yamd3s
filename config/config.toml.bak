# Auto configuration for [ Yamd3s ]

[general]
preset = "default"

# | Togglables
[components.bar]
launcher = true
workspaces = true
clock = true
volume = true
brightness = true
notifications = true
power = true

[components.hub]
dashboard = true
wallpaper = true
system = true
music = true
notifications = true

[components.widgets]
clock = true

# | Component behavior
[behavior.bar]
autoHide = true
autoHideDelay = 1000
revealOnEdge = true

[behavior.panels]
closeOnFocusLoss = true
closeOnEscape = true
animationEnabled = true

# | Theme Roles
[theme.roles]
workspaces = "tertiary"
clock = "secondary"
switcher = "secondary"
musicProgress = "secondary"
musicPlayButton = "primary"
volumeIcon = "tertiary"
brightnessIcon = "tertiary"
powermenu = "error"
notificationButton = "tertiary"
actionsButton = "secondary"